{
  "name": "@peiyanlu/svg-icons",
  "version": "0.0.1",
  "description": "A Vite plugin for building SVG icon sprites.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@peiyanlu/node-utils": "^0.1.1",
    "@peiyanlu/ts-utils": "^1.0.0",
    "svgo": "^4.1.0"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "author": {
    "name": "YanluPei",
    "email": "peiyanlu@vip.qq.com"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "typescript",
    "lib",
    "svg",
    "icons",
    "vite",
    "plugin",
    "vue",
    "react"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyanlu/icons.git",
    "directory": "packages/svg-icons"
  },
  "bugs": {
    "url": "https://github.com/peiyanlu/icons/issues"
  },
  "homepage": "https://github.com/peiyanlu/icons#readme"
}
